              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300 && Number.isInteger(pm.response.json().revision)) pm.collectionVariables.set('revision', pm.response.json().revision);",
              "pm.collectionVariables.set('token', pm.response.json().token);",
              "pm.test('User has no password hash', () => pm.expect(pm.response.json().user).not.to.have.property('passwordHash'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 Login",
