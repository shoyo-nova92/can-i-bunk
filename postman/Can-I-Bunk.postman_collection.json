{
  "info": {
    "name": "Can I Bunk — Assignment API verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against a disposable local/demo or Atlas test database. Creates two uniquely named synthetic accounts per run (no account-delete API); subject/session data is removed at the end. Never run with real student data. Tests auth, CRUD, stale revisions and cross-account isolation. Tokens/passwords are runtime values, not exported secrets."
  },
  "variable": [
    {
      "key": "revision",
      "value": "0"
    },
    {
      "key": "subjectId",
      "value": "demo-subject"
    },
    {
      "key": "sessionId",
      "value": "demo-session"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === '01 Health') {",
          "  const run = pm.variables.replaceIn('{{$guid}}');",
          "  pm.collectionVariables.set('email', 'postman-' + run + '@example.test');",
          "  pm.collectionVariables.set('otherEmail', 'other-' + run + '@example.test');",
          "  pm.collectionVariables.set('password', 'Demo-' + pm.variables.replaceIn('{{$guid}}') + '!');",
          "  pm.collectionVariables.set('subjectId', 'subject-' + run);",
          "  pm.collectionVariables.set('sessionId', 'session-' + run);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code < 300 && Number.isInteger(pm.response.json().revision)) pm.collectionVariables.set('revision', pm.response.json().revision);",
              "pm.test('MongoDB connected', () => pm.expect(pm.response.json().database).to.eql('connected'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "02 Registration",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
