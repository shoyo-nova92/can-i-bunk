# Atlas: create a database user and allow your laptop's current IP in Network Access.
# URL-encode special characters in the database password. Never commit the real URI.
MONGODB_URI=mongodb+srv://DATABASE_USER:URL_ENCODED_PASSWORD@CLUSTER.mongodb.net/can_i_bunk?retryWrites=true&w=majority
# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
HOST=127.0.0.1
PORT=3000
